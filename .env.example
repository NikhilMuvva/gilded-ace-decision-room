# Server only. Copy to ignored .env.local; set the real value privately.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional submission metadata only; never used as a secret or eligibility claim.
GEMINI_PROJECT_NUMBER=

# Server-only Tiger Cloud reader. Never deploy the admin/importer URL.
DATABASE_URL=
TIGER_SCHEMA=dashboard_hourly
TIGER_SERVICE_LABEL=gilded-ace-hourly
# Optional trusted CA PEM (literal newlines or escaped \n). Verification stays enabled.
TIGER_CA_CERT=
# Development-only exception label, if explicitly authorized: provisional-development.
# This label is rejected when VERCEL_ENV=production. Leave unset for normal trust.
TIGER_TLS_TRUST=
# Local importer only, ignored .env.local; never add to Vercel.
TIGER_IMPORT_DATABASE_URL=
TIGER_SSLROOTCERT=system
