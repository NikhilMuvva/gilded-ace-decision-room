{
  "name": "gilded-ace-decision-room",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start:local": "node scripts/dev_all.mjs",
    "dev:api": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.tiger-reader.local scripts/dev_api.mjs",
    "audit:algorithms": "python scripts/audit_algorithms.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data": "python scripts/build_data.py && python scripts/build_decision_evidence.py && node scripts/build_portfolios.mjs",
    "test:science": "python -m unittest discover -s tests -p test_*.py",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "vitest run",
    "tiger:source": "node --env-file-if-exists=.env.local scripts/tiger.mjs source",
    "tiger:import": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.tiger-admin-rotated.local --env-file-if-exists=.env.tiger-reader.local scripts/tiger.mjs import",
    "tiger:benchmark": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.tiger-reader.local scripts/tiger.mjs benchmark",
    "tiger:local": "node scripts/tiger.mjs local",
    "test:tiger:db": "node --env-file-if-exists=.env.tiger-test.local --test tests/tiger_integration.test.mjs",
    "verify": "npm run test:science && npm test && npm run test:ui && npm run build"
  },
  "dependencies": {
    "@vercel/functions": "3.11.0",
    "lucide-react": "0.468.0",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "happy-dom": "^21.0.4",
    "typescript": "5.7.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
